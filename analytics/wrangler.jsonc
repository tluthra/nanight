{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nanight-analytics",
  "account_id": "0dc781c7d9dca1a3ecad69c1c9ceb8a1",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "nanight-analytics",
    "database_id": "c066299e-8dab-456d-9c1f-6aedb7510516",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "PING_RATE_LIMIT",
    "namespace_id": "1001",
    "simple": { "limit": 60, "period": 60 }
  }],
  "triggers": { "crons": ["15 3 * * *"] }
}
